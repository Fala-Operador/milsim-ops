# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis como
# segredos no ambiente de publicação (ex.: Lovable → Settings → Secrets).
# Valores: Supabase Dashboard → Project Settings → API Keys.

SUPABASE_URL=https://<project-ref>.supabase.co
# Chave publicável (sb_publishable_...): usada pelo servidor para a sessão do Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...): SOMENTE servidor. Nunca exponha no navegador.
SUPABASE_SECRET_KEY=
# Senha do banco (apenas para `supabase link` / `supabase db push`).
SUPABASE_DB_PASSWORD=
# Opcional: venda de ingressos com Stripe Checkout (Stripe Dashboard → Developers).
# Sem STRIPE_SECRET_KEY as inscrições são confirmadas sem cobrança. Aplique antes
# docs/migracoes/20261019150000_pagamentos_stripe.sql.
# Chave secreta (sk_live_... ou sk_test_...): SOMENTE servidor.
STRIPE_SECRET_KEY=
# Segredo do webhook (whsec_...) do endpoint https://<seu-dominio>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Repasse às organizações (Stripe Connect Express). Segredo do endpoint de Connect
# (mesma URL, evento account.updated) e taxa da plataforma em % (ex.: 8.5). Sem taxa = 0.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_TAXA_PLATAFORMA_PERCENTUAL=
# Opcional: habilita Admin › Insights IA.
LOVABLE_API_KEY=
