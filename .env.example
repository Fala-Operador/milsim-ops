# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis como
# segredos no ambiente de publicação (ex.: Lovable → Settings → Secrets).
# Valores: Supabase Dashboard → Project Settings → API Keys.

SUPABASE_URL=https://<project-ref>.supabase.co
# Chave publicável (sb_publishable_...): usada pelo servidor para a sessão do Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...): SOMENTE servidor. Nunca exponha no navegador.
SUPABASE_SECRET_KEY=
# Senha do banco (apenas para `supabase link` / `supabase db push`).
SUPABASE_DB_PASSWORD=
# Opcional: habilita Admin › Insights IA.
LOVABLE_API_KEY=
